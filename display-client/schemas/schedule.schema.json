{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/display/schedule-v1.json",
  "title": "Signage Asia/Seoul schedule",
  "type": "object",
  "required": ["schemaVersion", "timezone", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "timezone": {"const": "Asia/Seoul"},
    "events": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "location",
          "daysOfWeek",
          "date",
          "startTime",
          "endTime",
          "endsNextDay",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "location": {"type": "string", "minLength": 1, "maxLength": 100},
          "daysOfWeek": {
            "type": ["array", "null"],
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 7}
          },
          "date": {"type": ["string", "null"], "format": "date"},
          "startTime": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "endsNextDay": {"type": "boolean"},
          "priority": {"type": "integer", "minimum": -1000, "maximum": 1000}
        },
        "oneOf": [
          {
            "properties": {
              "daysOfWeek": {"type": "array"},
              "date": {"type": "null"}
            }
          },
          {
            "properties": {
              "daysOfWeek": {"type": "null"},
              "date": {"type": "string", "format": "date"}
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
