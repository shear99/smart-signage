{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/display/subtitle-v2.json",
  "title": "Signage subtitles",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "duration": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000
    },
    "effect": {
      "enum": ["fade", "slide_left", "slide_up", "soft_zoom"],
      "default": "fade"
    },
    "fontSizePx": {
      "type": "integer",
      "minimum": 24,
      "maximum": 96,
      "default": 60
    },
    "transitionMs": {
      "type": "integer",
      "minimum": 150,
      "maximum": 3000,
      "default": 700
    },
    "span": {
      "type": "object",
      "required": ["text", "size", "marks"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "size": {"enum": ["small", "normal", "large"]},
        "marks": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["bold", "italic", "underline", "strike"]}
        }
      },
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "required": ["spans"],
      "properties": {
        "spans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/span"}
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "messages"],
      "properties": {
        "schemaVersion": {"const": 1},
        "messages": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["id", "text", "durationMs"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "text": {"type": "string", "maxLength": 2000},
              "durationMs": {"$ref": "#/$defs/duration"},
              "effect": {"$ref": "#/$defs/effect"},
              "fontSizePx": {"$ref": "#/$defs/fontSizePx"},
              "transitionMs": {"$ref": "#/$defs/transitionMs"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "messages"],
      "properties": {
        "schemaVersion": {"const": 2},
        "messages": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["id", "lines", "durationMs"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "durationMs": {"$ref": "#/$defs/duration"},
              "effect": {"$ref": "#/$defs/effect"},
              "fontSizePx": {"$ref": "#/$defs/fontSizePx"},
              "transitionMs": {"$ref": "#/$defs/transitionMs"},
              "lines": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {"$ref": "#/$defs/line"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
